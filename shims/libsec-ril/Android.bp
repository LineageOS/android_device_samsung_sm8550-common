cc_library_shared {
    name: "libsec-ril",
    vendor: true,
    compile_multilib: "64",
    srcs: ["libsec_ril_smsc_shim.cpp", "SmscAddress.cpp"],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DANDROID_MULTI_SIM",
        "-DANDROID_SIM_COUNT_2",
        "-DRIL_SHLIB",
        "-DREAL_LIB_NAME=\"libsec-ril-impl.so\"",
    ],
    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],
    header_libs: ["samsung_sm8550_call_state_headers"],
    include_dirs: [
        "hardware/ril/include",
    ],
}
